    @jsondata:Name {value: "tax_number"}
    TaxNumber? taxNumber?;
    @jsondata:Name {value: "downstream_id"}
    DownstreamId? downstreamId?;
    # Indicates the associated currency for an amount of money. Values correspond to [ISO 4217](https://en.wikipedia.org/wiki/ISO_4217)
    Currency? currency?;
    # A unique identifier for an object
    Id id;
    @jsondata:Name {value: "first_name"}
    FirstName? firstName?;
    @jsondata:Name {value: "payment_method"}
    PaymentMethod? paymentMethod?;
    @jsondata:Name {value: "company_id"}
    AccountingCompanyId? companyId?;
    # Is this an individual or business customer
    boolean? individual?;
    # Whether the entity is subject to taxation
