    @jsondata:Name {value: "purchase_order_id"}
    string? purchaseOrderId?;
    @jsondata:Name {value: "created_at"}
    CreatedAt? createdAt?;
    @jsondata:Name {value: "line_items"}
    GoodsReceiptLineItem[] lineItems?;
    # ID of the warehouse or location the goods were received into
    @jsondata:Name {value: "location_id"}
    string? locationId?;
    @jsondata:Name {value: "custom_mappings"}
    CustomMappings? customMappings?;
    # Supplier-side reference recorded on the receipt, typically the supplier's delivery note or packing slip number
    string? reference?;
    # Human-readable number of the purchase order this receipt was created against
    @jsondata:Name {value: "po_number"}
    string? poNumber?;
    @jsondata:Name {value: "currency_rate"}
    CurrencyRate? currencyRate?;
    @jsondata:Name {value: "updated_at"}
    UpdatedAt? updatedAt?;
    # Date the goods were received - YYYY-MM-DD
    @jsondata:Name {value: "received_date"}
    string? receivedDate?;
    # The supplier this entity is linked to
    LinkedSupplier? supplier?;
    @jsondata:Name {value: "downstream_id"}
    DownstreamId? downstreamId?;
    # Indicates the associated currency for an amount of money. Values correspond to [ISO 4217](https://en.wikipedia.org/wiki/ISO_4217)
    Currency? currency?;
    # A unique identifier for an object
    Id id;
    @jsondata:Name {value: "company_id"}
    AccountingCompanyId? companyId?;
    @jsondata:Name {value: "department_id"}
    DepartmentId? departmentId?;
    @jsondata:Name {value: "custom_fields"}
    CustomField[] customFields?;
    @jsondata:Name {value: "tracking_categories"}
    LinkedTrackingCategories? trackingCategories?;
    @jsondata:Name {value: "created_by"}
    CreatedBy? createdBy?;
    # Human-readable document number of the goods receipt as shown in the accounting system
    @jsondata:Name {value: "receipt_number"}
    string? receiptNumber?;
    @jsondata:Name {value: "row_version"}
    RowVersion? rowVersion?;
    @jsondata:Name {value: "updated_by"}
    UpdatedBy? updatedBy?;
    @jsondata:Name {value: "subsidiary_id"}
    SubsidiaryId? subsidiaryId?;
    # Accounting posting date of the receipt when the system distinguishes it from the received date - YYYY-MM-DD
    @jsondata:Name {value: "posted_date"}
    string? postedDate?;
    # Lifecycle status of the receipt. `draft` covers unposted or awaiting-validation documents, `pending_approval` covers documents submitted into an approval flow, `received` covers posted/validated/released receipts that have affected stock or the receiving ledger, `cancelled` covers voided, reversed or denied receipts
    "draft"|"pending_approval"|"received"|"cancelled"|"other"? status?;
|};

