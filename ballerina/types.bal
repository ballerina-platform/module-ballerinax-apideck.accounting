# The writable shape of Bill for a batch create. Identical to [Bill](the model returned on reads) with the read-only properties removed — the same properties the single-record create endpoint rejects, so a batched record and a single-record create accept exactly the same body
public type BillCreateInput record {|
    string? notes?;
    LinkedAttachment[] attachments?;
    @jsondata:Name {value: "display_id"}
    DisplayId? displayId?;
    # Date bill was issued - YYYY-MM-DD
    @jsondata:Name {value: "bill_date"}
    string? billDate?;
    @jsondata:Name {value: "terms_id"}
    TermsId? termsId?;
    # The channel through which the transaction is processed
    Channel? channel?;
    # language code according to ISO 639-1. For the United States - EN
    Language? language?;
    @jsondata:Name {value: "line_items"}
    BillLineItem[] lineItems?;
    @jsondata:Name {value: "discount_percentage"}
    DiscountPercentage? discountPercentage?;
    # Method of tax calculation
    @jsondata:Name {value: "tax_method"}
    string? taxMethod?;
    @jsondata:Name {value: "location_id"}
    LocationId? locationId?;
    # Optional reference identifier for the transaction
    Reference? reference?;
    @jsondata:Name {value: "currency_rate"}
    CurrencyRate? currencyRate?;
    # A PO Number uniquely identifies a purchase order and is generally defined by the buyer. The buyer will match the PO number in the invoice to the Purchase Order
    @jsondata:Name {value: "po_number"}
    string? poNumber?;
    # Total amount of bill, including tax
    decimal? total?;
    # Reference to supplier bill number
    @jsondata:Name {value: "bill_number"}
    string? billNumber?;
    # Balance of bill due
    decimal? balance?;
    # Terms of payment
    string? terms?;
    @jsondata:Name {value: "ledger_account"}
    LinkedLedgerAccount? ledgerAccount?;
    # The supplier this entity is linked to
    LinkedSupplier? supplier?;
    # Indicates the associated currency for an amount of money. Values correspond to [ISO 4217](https://en.wikipedia.org/wiki/ISO_4217)
    Currency? currency?;
    @jsondata:Name {value: "payment_method"}
    PaymentMethod? paymentMethod?;
    @jsondata:Name {value: "accounting_by_row"}
    AccountingByRow? accountingByRow?;
    @jsondata:Name {value: "bank_account"}
    BankAccount bankAccount?;
    @jsondata:Name {value: "company_id"}
    AccountingCompanyId? companyId?;
    @jsondata:Name {value: "department_id"}
    DepartmentId? departmentId?;
    @jsondata:Name {value: "custom_fields"}
    CustomField[] customFields?;
    @jsondata:Name {value: "pass_through"}
    PassThroughBody passThrough?;
    @jsondata:Name {value: "due_date"}
    DueDate? dueDate?;
    @jsondata:Name {value: "tax_inclusive"}
    TaxInclusive? taxInclusive?;
    # Whether the document has been received
    @jsondata:Name {value: "document_received"}
    boolean? documentReceived?;
    @jsondata:Name {value: "total_tax"}
    TotalTax? totalTax?;
    @jsondata:Name {value: "tracking_categories"}
    LinkedTrackingCategories? trackingCategories?;
    LinkedSubsidiary? subsidiary?;
    @jsondata:Name {value: "tax_code"}
    TaxCode? taxCode?;
    # The user who approved the bill
    @jsondata:Name {value: "approved_by"}
    string? approvedBy?;
    @jsondata:Name {value: "row_version"}
    RowVersion? rowVersion?;
    @jsondata:Name {value: "sub_total"}
    SubTotal? subTotal?;
    # Amount of deposit made to this bill
    decimal? deposit?;
    # Optional bill template
    @jsondata:Name {value: "template_id"}
    string? templateId?;
    # URL link to a source document - shown as 'Go to [appName]' in the downstream app. Currently only supported for Xero
    @jsondata:Name {value: "source_document_url"}
    string? sourceDocumentUrl?;
    @jsondata:Name {value: "payment_allocations"}
    LinkedPaymentAllocations? paymentAllocations?;
    @jsondata:Name {value: "accounting_period"}
    AccountingPeriod? accountingPeriod?;
    # The paid date is the date on which a payment was sent to the supplier - YYYY-MM-DD
    @jsondata:Name {value: "paid_date"}
    string? paidDate?;
    # Type of amortization
    @jsondata:Name {value: "amortization_type"}
    "manual"|"receipt"|"schedule"|"other"? amortizationType?;
    # Invoice status
    "draft"|"submitted"|"authorised"|"partially_paid"|"paid"|"void"|"credit"|"deleted"|"posted"? status?;
|};

