# The name of the company
public type CompanyName string?;

# The writable shape of LedgerAccount for a batch create. Identical to [LedgerAccount](the model returned on reads) with the read-only properties removed — the same properties the single-record create endpoint rejects, so a batched record and a single-record create accept exactly the same body
public type LedgerAccountCreateInput record {|
    # The code assigned to the account
    string? code?;
    # The fully qualified name of the account
    @jsondata:Name {value: "fully_qualified_name"}
    string? fullyQualifiedName?;
    # The human readable display ID used when displaying the account
    @jsondata:Name {value: "display_id"}
    string displayId?;
    # The description of the account
    string? description?;
    # The type of account
    "accounts_payable"|"accounts_receivable"|"balancesheet"|"bank"|"costs_of_sales"|"credit_card"|"current_asset"|"current_liability"|"equity"|"expense"|"fixed_asset"|"non_current_asset"|"non_current_liability"|"other_asset"|"other_expense"|"other_income"|"other_liability"|"revenue"|"sales"|"other" 'type?;
    # Whether the account is a sub account or not
    @jsondata:Name {value: "sub_account"}
    boolean? subAccount?;
    @jsondata:Name {value: "tax_rate"}
    LinkedTaxRate taxRate?;
    # Reconciliation Date means the last calendar day of each Reconciliation Period
    @jsondata:Name {value: "last_reconciliation_date"}
    string? lastReconciliationDate?;
    # The sub type of account
    @jsondata:Name {value: "sub_type"}
    string? subType?;
    # The current balance of the account
    @jsondata:Name {value: "current_balance"}
    decimal? currentBalance?;
    # Indicates the associated currency for an amount of money. Values correspond to [ISO 4217](https://en.wikipedia.org/wiki/ISO_4217)
    Currency? currency?;
    # The opening balance of the account
    @jsondata:Name {value: "opening_balance"}
    decimal? openingBalance?;
    @jsondata:Name {value: "bank_account"}
    BankAccount bankAccount?;
    decimal? level?;
    @jsondata:Name {value: "custom_fields"}
    CustomField[] customFields?;
    @jsondata:Name {value: "pass_through"}
    PassThroughBody passThrough?;
    # Whether the account is active or not
    boolean? active?;
    # The classification of account
    "asset"|"equity"|"expense"|"liability"|"revenue"|"income"|"other_income"|"other_expense"|"costs_of_sales"|"other"? classification?;
    @jsondata:Name {value: "parent_account"}
    LedgerAccountParentAccount parentAccount?;
    # The tax type of the account
    @jsondata:Name {value: "tax_type"}
    string? taxType?;
    # The nominal code of the ledger account
    # 
    # # Deprecated
    @jsondata:Name {value: "nominal_code"}
    @deprecated
    string? nominalCode?;
    @jsondata:Name {value: "row_version"}
    RowVersion? rowVersion?;
    # The name of the account
    string? name?;
    # Whether the account is a header or not
    boolean? header?;
    # The subsidiaries the account belongs to
    LedgerAccountSubsidiaries[] subsidiaries?;
    # The status of the account
    "active"|"inactive"|"archived"? status?;
|};

# A balance sheet equity account represents the financial position of a company at a specific point in time
public type BalanceSheetEquityAccount record {|
    @jsondata:Name {value: "account_id"}
    AccountId accountId?;
    # The account code of the account
    AccountCode code?;
    # The name of the account
    AccountName name?;
    # The amount or value of the item
    Amount value?;
    # A list of balance sheet accounts
    BalanceSheetAccounts? items?;
|};

# Bank branch identifier
public type BranchIdentifier string?;

public type BillCreditNote record {|
    # Optional note to be associated with the bill credit note
    string? note?;
    @jsondata:Name {value: "created_at"}
    CreatedAt? createdAt?;
    @jsondata:Name {value: "line_items"}
    BillCreditNoteLineItem[] lineItems?;
    # The type of credit note. A bill credit note is always an accounts payable (supplier-side) credit
    "accounts_payable_credit" 'type?;
    @jsondata:Name {value: "custom_mappings"}
    CustomMappings? customMappings?;
    # Optional reference message ie: Debit remittance detail
    string? reference?;
    # Bill credit note number
    string? number?;
    @jsondata:Name {value: "currency_rate"}
    CurrencyRate? currencyRate?;
    # Indicates the total credit amount still available to apply towards the payment
    @jsondata:Name {value: "remaining_credit"}
    decimal? remainingCredit?;
    # The balance reflecting any payments made against the transaction
    decimal? balance?;
    Allocation[] allocations?;
    @jsondata:Name {value: "updated_at"}
    UpdatedAt? updatedAt?;
    # Date bill credit note paid - YYYY:MM::DDThh:mm:ss.sTZD
    @jsondata:Name {value: "date_paid"}
    string? datePaid?;
    # Optional terms to be associated with the bill credit note
    string? terms?;
    # The supplier this entity is linked to
    LinkedSupplier? supplier?;
    # Indicates the associated currency for an amount of money. Values correspond to [ISO 4217](https://en.wikipedia.org/wiki/ISO_4217)
    Currency? currency?;
    # Unique identifier representing the entity
    string id?;
    LinkedDepartment? department?;
    @jsondata:Name {value: "custom_fields"}
    CustomField[] customFields?;
    @jsondata:Name {value: "pass_through"}
    PassThroughBody passThrough?;
    @jsondata:Name {value: "tax_inclusive"}
    TaxInclusive? taxInclusive?;
    # Total tax amount applied to this bill credit note
    @jsondata:Name {value: "total_tax"}
    decimal? totalTax?;
    @jsondata:Name {value: "tracking_categories"}
    LinkedTrackingCategories? trackingCategories?;
    @jsondata:Name {value: "created_by"}
    CreatedBy? createdBy?;
    LinkedSubsidiary? subsidiary?;
    # Applicable tax id/code override if tax is not supplied on a line item basis
    @jsondata:Name {value: "tax_code"}
    string? taxCode?;
    # Amount of transaction
    @jsondata:Name {value: "total_amount"}
    decimal totalAmount?;
    # Date bill credit note issued - YYYY:MM::DDThh:mm:ss.sTZD
    @jsondata:Name {value: "date_issued"}
    string dateIssued?;
    @jsondata:Name {value: "row_version"}
    RowVersion? rowVersion?;
    # Sub-total amount, normally before tax
    @jsondata:Name {value: "sub_total"}
    decimal? subTotal?;
    @jsondata:Name {value: "updated_by"}
    UpdatedBy? updatedBy?;
    LinkedLocation? location?;
    LinkedLedgerAccount? account?;
    # Status of bill credit notes
    "draft"|"authorised"|"posted"|"partially_paid"|"paid"|"voided"|"deleted" status?;
|};

