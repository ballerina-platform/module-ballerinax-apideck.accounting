    decimal? subTotal?;
    @jsondata:Name {value: "updated_by"}
    UpdatedBy? updatedBy?;
    LinkedLedgerAccount? account?;
    # The customer this entity is linked to
    LinkedCustomer? customer?;
    # Status of credit notes
    "draft"|"authorised"|"posted"|"partially_paid"|"paid"|"voided"|"deleted" status?;
|};

