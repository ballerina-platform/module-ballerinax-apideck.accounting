public type GeneralLedgerTransactionLineItem record {|
    # Tax embedded in the line. In GL views this is typically 0 or null because tax has its own dedicated line against a tax payable/receivable account. Exposed for completeness and for tax-inclusive setups
    @jsondata:Name {value: "tax_amount"}
    decimal? taxAmount?;
    @jsondata:Name {value: "ledger_account"}
    LinkedLedgerAccount? ledgerAccount;
    @jsondata:Name {value: "line_number"}
    LineNumber? lineNumber?;
    # Free-text description of the line
    string? description?;
    # A unique identifier for an object
    Id id?;
    # The amount posted to the ledger account, tax-exclusive. Debit entries are positive, credit entries are negative. In general-ledger views the tax component lives in its own dedicated line against a tax payable/receivable account, so net_amount is the canonical figure for reporting
    @jsondata:Name {value: "net_amount"}
    decimal? netAmount?;
    # Side of the entry. Redundant with the sign of net_amount but exposed as an explicit flag for filtering convenience
    "debit"|"credit"? 'type;
    @jsondata:Name {value: "tracking_categories"}
    LinkedTrackingCategories? trackingCategories?;
    @jsondata:Name {value: "tax_rate"}
    LinkedTaxRate taxRate?;
|};

