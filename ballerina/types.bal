public type JournalEntryLineItem record {|
    # Tax amount
    @jsondata:Name {value: "tax_amount"}
    decimal? taxAmount?;
    # The financial date of this specific line, when it differs from the journal entry's own posted_at date - for example when booking a historical or backdated transaction. Not populated by every connector: some post the entry date at the header level only, in which case this line-level date is legitimately absent rather than wrong
    string? date?;
    @jsondata:Name {value: "department_id"}
    DepartmentId? departmentId?;
    # Worktags of the line item. This is currently only supported in Workday
    LinkedWorktag[] worktags?;
    # User defined description
    string? description?;
    @jsondata:Name {value: "tracking_category"}
    DeprecatedLinkedTrackingCategory? trackingCategory?;
    # Debit entries are considered positive, and credit entries are considered negative
    "debit"|"credit"? 'type;
    # The employee this entity is linked to
    LinkedEmployee? employee?;
    # Amount for this line in the company's base currency. Used when the journal entry currency differs from the company's base currency
    @jsondata:Name {value: "base_currency_amount"}
    decimal? baseCurrencyAmount?;
    @jsondata:Name {value: "tracking_categories"}
    LinkedTrackingCategories? trackingCategories?;
    @jsondata:Name {value: "tax_rate"}
    LinkedTaxRate taxRate?;
    @jsondata:Name {value: "location_id"}
    LocationId? locationId?;
    # Debit entries are considered positive, and credit entries are considered negative
    @jsondata:Name {value: "total_amount"}
    decimal? totalAmount?;
    # The tax applicability of this line item. Overrides the root-level tax_type for this line
    @jsondata:Name {value: "tax_type"}
    "sales"|"purchase"? taxType?;
    @jsondata:Name {value: "ledger_account"}
    LinkedLedgerAccount? ledgerAccount;
    @jsondata:Name {value: "line_number"}
    LineNumber? lineNumber?;
    # The supplier this entity is linked to
    LinkedSupplier? supplier?;
    # Sub-total amount, normally before tax
    @jsondata:Name {value: "sub_total"}
    decimal? subTotal?;
    # A unique identifier for an object
    Id id?;
    # A unique identifier for the source of this specific line, distinct from the journal entry's own source_id. Useful for reconciling an individual line back to an external system's own record when a single journal entry aggregates lines originating from more than one source
    @jsondata:Name {value: "source_id"}
    string? sourceId?;
    # The customer this entity is linked to
    LinkedCustomer? customer?;
|};

