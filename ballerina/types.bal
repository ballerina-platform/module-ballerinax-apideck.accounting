public type TaxRate record {|
    # Country code according to ISO 3166-1 alpha-2
    string? country?;
    TaxRateComponents[]? components?;
    # Tax code assigned to identify this tax rate
    string? code?;
    # Display ID of the tax rate
    @jsondata:Name {value: "display_id"}
    string? displayId?;
    @jsondata:Name {value: "custom_fields"}
    CustomField[] customFields?;
    @jsondata:Name {value: "pass_through"}
    PassThroughBody passThrough?;
    # Description of tax rate
    string? description?;
    @jsondata:Name {value: "created_at"}
    CreatedAt? createdAt?;
    # Tax type used to indicate the source of tax collected or paid
    string? 'type?;
    @jsondata:Name {value: "created_by"}
    CreatedBy? createdBy?;
    @jsondata:Name {value: "custom_mappings"}
    CustomMappings? customMappings?;
    # Unique identifier for the account for tax remitted
    @jsondata:Name {value: "tax_remitted_account_id"}
    string? taxRemittedAccountId?;
    # ID of the original tax rate from which the new tax rate is derived. Helps to understand the relationship between corresponding tax rate entities
    @jsondata:Name {value: "original_tax_rate_id"}
    string? originalTaxRateId?;
    # Unique identifier for the account for tax collected
    @jsondata:Name {value: "tax_payable_account_id"}
    string? taxPayableAccountId?;
    @jsondata:Name {value: "updated_at"}
    UpdatedAt? updatedAt?;
    # Report Tax type to aggregate tax collected or paid for reporting purposes
    @jsondata:Name {value: "report_tax_type"}
    string? reportTaxType?;
    @jsondata:Name {value: "row_version"}
    RowVersion? rowVersion?;
    # Name assigned to identify this tax rate
    @constraint:String {minLength: 1}
    string name?;
    @jsondata:Name {value: "updated_by"}
    UpdatedBy? updatedBy?;
    # The subsidiaries this belongs to
    LedgerAccountSubsidiaries[] subsidiaries?;
    # ID assigned to identify this tax rate
    string? id?;
    # Effective tax rate
    @jsondata:Name {value: "effective_tax_rate"}
    decimal? effectiveTaxRate?;
    # Not compounded sum of the components of a tax rate
    @jsondata:Name {value: "total_tax_rate"}
    decimal? totalTaxRate?;
    # Tax rate status
    "active"|"inactive"|"archived"? status?;
|};

