public type Project record {|
    # Expected or planned end date of the project
    @jsondata:Name {value: "end_date"}
    string? endDate?;
    # Percentage of project completion (0-100)
    @jsondata:Name {value: "completion_percentage"}
    decimal? completionPercentage?;
    # Method used for billing this project
    @jsondata:Name {value: "billing_method"}
    "fixed_price"|"time_and_materials"|"milestone_based"|"retainer"|"non_billable"? billingMethod?;
    # An array of addresses associated with the project (billing, job site, etc.)
    Address[] addresses?;
    # Additional notes about the project
    string? notes?;
    # External reference identifier for the project
    @jsondata:Name {value: "reference_id"}
    string? referenceId?;
    # User-friendly project identifier
    @jsondata:Name {value: "display_id"}
    string? displayId?;
    # ID of the user who owns/manages this project
    @jsondata:Name {value: "owner_id"}
    string? ownerId?;
    # Total actual amount spent on the project
    @jsondata:Name {value: "actual_amount"}
    decimal? actualAmount?;
    # Detailed description of the project
    string? description?;
    @jsondata:Name {value: "created_at"}
    CreatedAt? createdAt?;
    @jsondata:Name {value: "tax_rate"}
    LinkedTaxRate taxRate?;
    @jsondata:Name {value: "updated_at"}
    UpdatedAt? updatedAt?;
    # Total actual hours worked on the project
    @jsondata:Name {value: "actual_hours"}
    decimal? actualHours?;
    # Contract or agreement number associated with the project
    @jsondata:Name {value: "contract_number"}
    string? contractNumber?;
    @jsondata:Name {value: "downstream_id"}
    DownstreamId? downstreamId?;
    # Indicates the associated currency for an amount of money. Values correspond to [ISO 4217](https://en.wikipedia.org/wiki/ISO_4217)
    Currency? currency?;
    # Current status of project schedule compared to plan
    @jsondata:Name {value: "schedule_status"}
    "ahead_of_schedule"|"on_schedule"|"behind_schedule"|"critical_delay"? scheduleStatus?;
    # A unique identifier for an object
    Id id?;
    # Department or organizational unit associated with the project
    Department? department?;
    # Approved budget amount for the project
    @jsondata:Name {value: "approved_amount"}
    decimal? approvedAmount?;
    # Start date of the project
    @jsondata:Name {value: "start_date"}
    string? startDate?;
    # Current phase of the project lifecycle
    "initiation"|"planning"|"execution"|"monitoring"|"closure"|"other"? phase?;
    # Type or category of the project
    @jsondata:Name {value: "project_type"}
    "client_project"|"internal_project"|"maintenance"|"research_development"|"training"|"other"? projectType?;
    @jsondata:Name {value: "company_id"}
    AccountingCompanyId? companyId?;
    # Number of team members assigned to the project
    @jsondata:Name {value: "team_size"}
    int? teamSize?;
    # Total budgeted hours for the project
    @jsondata:Name {value: "budget_hours"}
    decimal? budgetHours?;
    @jsondata:Name {value: "custom_fields"}
    CustomField[] customFields?;
    # Indicates whether the project is currently active or inactive
    boolean? active?;
    # Indicates if the project is billable to the customer
    @jsondata:Name {value: "is_billable"}
    boolean? isBillable = true;
    # Priority level of the project
    "low"|"medium"|"high"|"critical"? priority?;
    @jsondata:Name {value: "tracking_categories"}
    LinkedTrackingCategories? trackingCategories?;
    @jsondata:Name {value: "created_by"}
    CreatedBy? createdBy?;
    # Tags associated with the project
    string[] tags?;
    @jsondata:Name {value: "parent_project"}
    ParentProject? parentProject?;
    # Default hourly rate for project work
    @jsondata:Name {value: "hourly_rate"}
    decimal? hourlyRate?;
    @jsondata:Name {value: "row_version"}
    RowVersion? rowVersion?;
    # Name of the project
    @constraint:String {minLength: 1}
    string name;
    # Expected profit margin percentage for the project
    @jsondata:Name {value: "profit_margin"}
    decimal? profitMargin?;
    @jsondata:Name {value: "updated_by"}
    UpdatedBy? updatedBy?;
    # Actual end date of the project
    @jsondata:Name {value: "completion_date"}
    string? completionDate?;
    # Current status of the project
    "active"|"completed"|"on_hold"|"cancelled"|"draft"|"in_progress"|"approved"|"other"? status?;
    # The customer this entity is linked to
    LinkedCustomer? customer?;
    # Total budgeted amount for the project
    @jsondata:Name {value: "budget_amount"}
    decimal? budgetAmount?;
|};

public type Refund record {|
    # Optional note to be associated with the refund
    string? note?;
    # Discount amount applied to this refund
    @jsondata:Name {value: "discount_amount"}
    decimal? discountAmount?;
    @jsondata:Name {value: "created_at"}
    CreatedAt? createdAt?;
    @jsondata:Name {value: "billing_address"}
    Address billingAddress?;
    # Line items for itemized refunds (type: refund_receipt or sale_refund). Used when the refund includes product/service details with quantities and pricing. Supported by QBO RefundReceipt and NetSuite CashRefund
    @jsondata:Name {value: "line_items"}
    InvoiceLineItem[] lineItems?;
    # Discount percentage applied to this refund
    @jsondata:Name {value: "discount_percentage"}
    decimal? discountPercentage?;
    # Type of refund. `refund_receipt` for itemized refunds with product/service lines and payment (QBO RefundReceipt; also NetSuite's apply-list-based CustomerRefund). `cash_refund` for cash-out refunds with GL distribution or allocations (Sage Intacct). `credit_note_refund` for refunds applied against a credit note (Zoho Books). `sale_refund` for itemized refunds tied to a cash sale or return authorization, without an apply-list (NetSuite CashRefund) — NetSuite's apply-list-based CustomerRefund reports as `refund_receipt` instead
    RefundType 'type?;
    # Customer memo
    @jsondata:Name {value: "customer_memo"}
    string? customerMemo?;
    @jsondata:Name {value: "custom_mappings"}
    CustomMappings? customMappings?;
    # Optional reference message for the refund
    string? reference?;
    # Reference number for the refund
    string? number?;
    @jsondata:Name {value: "currency_rate"}
    CurrencyRate? currencyRate?;
    # Allocations linking refund to existing documents (invoices, credit notes, overpayments). Used for credit_note_refund and cash_refund types where the refund is applied against prior transactions. Supported by Sage Intacct and Zoho Books
    Allocation[] allocations?;
    @jsondata:Name {value: "updated_at"}
    UpdatedAt? updatedAt?;
    # Indicates the associated currency for an amount of money. Values correspond to [ISO 4217](https://en.wikipedia.org/wiki/ISO_4217)
    Currency? currency?;
    # Unique identifier representing the refund
    string id?;
    @jsondata:Name {value: "shipping_address"}
    Address shippingAddress?;
    LinkedDepartment? department?;
    @jsondata:Name {value: "payment_method"}
    PaymentMethod? paymentMethod?;
    @jsondata:Name {value: "company_id"}
    AccountingCompanyId? companyId?;
    @jsondata:Name {value: "custom_fields"}
    CustomField[] customFields?;
    @jsondata:Name {value: "payment_method_reference"}
    PaymentMethodReference? paymentMethodReference?;
    @jsondata:Name {value: "pass_through"}
    PassThroughBody passThrough?;
    @jsondata:Name {value: "tax_inclusive"}
    TaxInclusive? taxInclusive?;
    @jsondata:Name {value: "total_tax"}
    TotalTax? totalTax?;
    @jsondata:Name {value: "tracking_categories"}
    LinkedTrackingCategories? trackingCategories?;
    @jsondata:Name {value: "created_by"}
    CreatedBy? createdBy?;
    # The date of the refund - YYYY-MM-DDThh:mm:ss.sTZD
    @jsondata:Name {value: "refund_date"}
    string? refundDate?;
    @jsondata:Name {value: "payment_method_id"}
    WritableId? paymentMethodId?;
    # Applicable tax id/code override if tax is not supplied on a line item basis
    @jsondata:Name {value: "tax_code"}
    string? taxCode?;
    @jsondata:Name {value: "total_amount"}
    TotalAmount? totalAmount;
    @jsondata:Name {value: "row_version"}
    RowVersion? rowVersion?;
    @jsondata:Name {value: "sub_total"}
    SubTotal? subTotal?;
    @jsondata:Name {value: "updated_by"}
    UpdatedBy? updatedBy?;
    LinkedLocation? location?;
    LinkedLedgerAccount? account?;
    # The customer this entity is linked to
    LinkedCustomer? customer?;
    # Status of refund. Maps to: QBO (limited status), NetSuite CashRefund status, Sage Intacct state (draft/posted/voided), Zoho Books vis_state
    RefundStatus status?;
|};

