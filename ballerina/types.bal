    PassThroughBody passThrough?;
    # The name of the payment method
    string name?;
    @jsondata:Name {value: "updated_by"}
    UpdatedBy? updatedBy?;
    @jsondata:Name {value: "created_at"}
    CreatedAt? createdAt?;
    @jsondata:Name {value: "downstream_id"}
    DownstreamId? downstreamId?;
    # A unique identifier for an object
    Id id?;
    # The type of payment method
    "cash"|"check"|"credit_card"|"debit_card"|"bank_transfer"|"electronic"|"other"|"unknown"? 'type?;
    @jsondata:Name {value: "created_by"}
    CreatedBy? createdBy?;
    # The status of the payment method
    "active"|"inactive"? status?;
    @jsondata:Name {value: "custom_mappings"}
    CustomMappings? customMappings?;
|};

