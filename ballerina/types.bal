    Currency? currency?;
    @jsondata:Name {value: "payment_method"}
    PaymentMethod? paymentMethod?;
    @jsondata:Name {value: "transaction_date"}
    TransactionDate? transactionDate;
    # Unique identifier for the account to allocate payment to
    # 
    # # Deprecated
    @jsondata:Name {value: "accounts_receivable_account_id"}
    @deprecated
    string? accountsReceivableAccountId?;
    # Indicates if the transaction has been reconciled
    IsReconciled? reconciled?;
    @jsondata:Name {value: "company_id"}
    AccountingCompanyId? companyId?;
    @jsondata:Name {value: "custom_fields"}
    CustomField[] customFields?;
    @jsondata:Name {value: "payment_method_reference"}
    PaymentMethodReference? paymentMethodReference?;
    @jsondata:Name {value: "pass_through"}
    PassThroughBody passThrough?;
    @jsondata:Name {value: "tracking_categories"}
    LinkedTrackingCategories? trackingCategories?;
    LinkedSubsidiary? subsidiary?;
    @jsondata:Name {value: "payment_method_id"}
    WritableId? paymentMethodId?;
    # Type of accounts receivable account
