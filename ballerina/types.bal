    @deprecated
    string? accountsReceivableAccountType?;
    @jsondata:Name {value: "total_amount"}
    TotalAmount? totalAmount;
    @jsondata:Name {value: "row_version"}
    RowVersion? rowVersion?;
    LinkedLedgerAccount? account?;
