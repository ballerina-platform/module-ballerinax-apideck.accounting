public type Journal record {|
    @jsondata:Name {value: "clearing_account"}
    LinkedFinancialAccount? clearingAccount?;
    # Whether the journal permits VAT on entries. Null or absent means unknown. Exact Online exposes this setting for general journals; it must not be treated as a universal VAT capability flag for other journal types
    @jsondata:Name {value: "allow_vat"}
    boolean? allowVat?;
    # Code used to select this journal when posting entries. For Exact Online, pass this code as journal_symbol, not the journal id
    string? code?;
    # Description of the journal
    string? description?;
    @jsondata:Name {value: "created_at"}
    CreatedAt? createdAt?;
    # Normalized journal classification
    "general"|"sales"|"purchase"|"sales_credit_note"|"purchase_credit_note"|"cash"|"bank"|"payment_service"|"other"? 'type?;
    @jsondata:Name {value: "default_account"}
    LinkedFinancialAccount? defaultAccount?;
    @jsondata:Name {value: "custom_mappings"}
    CustomMappings? customMappings?;
    # Whether the journal is blocked for posting
    boolean? blocked?;
    @jsondata:Name {value: "updated_at"}
    UpdatedAt? updatedAt?;
    # International Bank Account Number
    IBAN? iban?;
    # Name of the journal
    string? name?;
    # Indicates the associated currency for an amount of money. Values correspond to [ISO 4217](https://en.wikipedia.org/wiki/ISO_4217)
    Currency? currency?;
    # A unique identifier for an object
    Id id?;
|};

public type AccountingPaymentMethod record {|
    @jsondata:Name {value: "updated_at"}
