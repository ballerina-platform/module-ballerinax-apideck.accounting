# The writable shape of JournalEntry for a batch create. Identical to [JournalEntry](the model returned on reads) with the read-only properties removed — the same properties the single-record create endpoint rejects, so a batched record and a single-record create accept exactly the same body
public type JournalEntryCreateInput record {|
    # Files attached to this journal entry. Use the attachments endpoints with reference_type=journal-entry and this entry's id where the connector supports it
    LinkedAttachment[] attachments?;
    @jsondata:Name {value: "company_id"}
    AccountingCompanyId? companyId?;
    # Display ID of the journal entry
    @jsondata:Name {value: "display_id"}
    string? displayId?;
    @jsondata:Name {value: "custom_fields"}
    CustomField[] customFields?;
    @jsondata:Name {value: "pass_through"}
    PassThroughBody passThrough?;
    # Reference for the journal entry
    string? memo?;
    @jsondata:Name {value: "tax_inclusive"}
    TaxInclusive? taxInclusive?;
    # The source type of the journal entry
    @jsondata:Name {value: "source_type"}
    string? sourceType?;
    # Requires a minimum of 2 line items that sum to 0
    @jsondata:Name {value: "line_items"}
    JournalEntryLineItem[] lineItems?;
    # Journal entry title
    string? title?;
    @jsondata:Name {value: "tracking_categories"}
    LinkedTrackingCategories? trackingCategories?;
    LinkedSubsidiary? subsidiary?;
    # Journal entry number
    string? number?;
    @jsondata:Name {value: "currency_rate"}
    CurrencyRate? currencyRate?;
    # Journal symbol of the entry. For example IND for indirect costs. Where supported, list /accounting/journals to discover available journals and their posting rules. For Exact Online, supply the journal code, not its id
    @jsondata:Name {value: "journal_symbol"}
    string? journalSymbol?;
    @jsondata:Name {value: "tax_code"}
    TaxCode? taxCode?;
    # Deprecated — use line_items[].tax_type for per-line tax applicability. Kept as fallback: applies to all lines that do not set their own tax_type
    # 
    # # Deprecated
    @jsondata:Name {value: "tax_type"}
    @deprecated
    string? taxType?;
    @jsondata:Name {value: "row_version"}
    RowVersion? rowVersion?;
    # Indicates the associated currency for an amount of money. Values correspond to [ISO 4217](https://en.wikipedia.org/wiki/ISO_4217)
    Currency? currency?;
    # A unique identifier for the source of the journal entry
    @jsondata:Name {value: "source_id"}
    string? sourceId?;
    # This is the date on which the journal entry was added. This can be different from the creation date and can also be backdated
    @jsondata:Name {value: "posted_at"}
    string postedAt?;
    @jsondata:Name {value: "accounting_period"}
    AccountingPeriod? accountingPeriod?;
    # Journal entry status
    "draft"|"pending_approval"|"approved"|"posted"|"voided"|"rejected"|"deleted"|"other"? status?;
|};

