    @jsondata:Name {value: "last_name"}
    LastName? lastName?;
    # Display name
    @jsondata:Name {value: "display_name"}
    string? displayName?;
    @jsondata:Name {value: "middle_name"}
    MiddleName? middleName?;
    @jsondata:Name {value: "created_by"}
    CreatedBy? createdBy?;
    LinkedSubsidiary? subsidiary?;
    @jsondata:Name {value: "phone_numbers"}
    PhoneNumber[] phoneNumbers?;
    @jsondata:Name {value: "company_name"}
    CompanyName? companyName?;
    @jsondata:Name {value: "row_version"}
    RowVersion? rowVersion?;
    @jsondata:Name {value: "updated_by"}
    UpdatedBy? updatedBy?;
    Website[] websites?;
    @jsondata:Name {value: "bank_accounts"}
    BankAccount[] bankAccounts?;
    LinkedLedgerAccount? account?;
    # Customer status
    "active"|"inactive"|"archived"|"gdpr-erasure-request"|"unknown"? status?;
|};

