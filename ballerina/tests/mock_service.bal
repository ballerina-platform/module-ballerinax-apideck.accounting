// Service-mode response types. `bal openapi --mode client` collapses 4XX/5XX
// to `error` and never emits these, so they are defined here for the mock only.
public type BadRequestResponseBadRequest record {|
    *http:BadRequest;
    BadRequestResponse body;
|};

public type NotFoundResponseNotFound record {|
    *http:NotFound;
    NotFoundResponse body;
|};

public type PaymentRequiredResponsePaymentRequired record {|
    *http:PaymentRequired;
    PaymentRequiredResponse body;
|};

public type UnauthorizedResponseUnauthorized record {|
    *http:Unauthorized;
    UnauthorizedResponse body;
|};

public type UnexpectedErrorResponseDefault record {|
    *http:DefaultStatusCodeResponse;
    UnexpectedErrorResponse body;
|};

public type UnprocessableResponseUnprocessableEntity record {|
    *http:UnprocessableEntity;
    UnprocessableResponse body;
|};

public type BadRequestResponse record {
    # The type of error returned
    @jsondata:Name {value: "type_name"}
    string typeName?;
    # Link to documentation of error type
    string ref?;
    # HTTP status code
    @jsondata:Name {value: "status_code"}
    decimal statusCode?;
    # Contains parameter or domain specific information related to the error and why it occurred
    string|record {} detail?;
    # Contains an explanation of the status_code as defined in HTTP/1.1 standard (RFC 7231)
    string 'error?;
    # A human-readable message providing more details about the error
    string message?;
    # Contains downstream errors returned from the connector. Only present when type_name is ConnectorExecutionError
    @jsondata:Name {value: "downstream_errors"}
    BadRequestResponseDownstreamErrors[] downstreamErrors?;
};

public type NotFoundResponse record {
    # The type of error returned
    @jsondata:Name {value: "type_name"}
    string typeName?;
    # Link to documentation of error type
    string ref?;
    # HTTP status code
    @jsondata:Name {value: "status_code"}
    decimal statusCode?;
    # Contains parameter or domain specific information related to the error and why it occurred
    string|record {} detail?;
    # Contains an explanation of the status_code as defined in HTTP/1.1 standard (RFC 7231)
    string 'error?;
    # A human-readable message providing more details about the error
    string message?;
};

public type PaymentRequiredResponse record {
    # The type of error returned
    @jsondata:Name {value: "type_name"}
    string typeName?;
    # Link to documentation of error type
    string ref?;
    # HTTP status code
    @jsondata:Name {value: "status_code"}
    decimal statusCode?;
    # Contains parameter or domain specific information related to the error and why it occurred
    string detail?;
    # Contains an explanation of the status_code as defined in HTTP/1.1 standard (RFC 7231)
    string 'error?;
    # A human-readable message providing more details about the error
    string message?;
};

public type UnauthorizedResponse record {
    # The type of error returned
    @jsondata:Name {value: "type_name"}
    string typeName?;
    # Link to documentation of error type
    string ref?;
    # HTTP status code
    @jsondata:Name {value: "status_code"}
    decimal statusCode?;
    # Contains parameter or domain specific information related to the error and why it occurred
    string|record {string 'type?; string message?; record {record {} request?; record {} response?; string message?; string code?; decimal credentials_expire_at_ms?; decimal retry_after_ms?; decimal cooldown_remaining_ms?;} debug?;} detail?;
    # Contains an explanation of the status_code as defined in HTTP/1.1 standard (RFC 7231)
    string 'error?;
    # A human-readable message providing more details about the error
    string message?;
};

public type UnexpectedErrorResponse record {
    # The type of error returned
    @jsondata:Name {value: "type_name"}
    string typeName?;
    # Link to documentation of error type
    string ref?;
    # HTTP status code
    @jsondata:Name {value: "status_code"}
    decimal statusCode?;
    # Contains parameter or domain specific information related to the error and why it occurred
